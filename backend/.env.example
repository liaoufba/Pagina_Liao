# Environment variables for LIAO Backend

# Database Configuration
# Toggle which stored URL the app uses. .env is never rewritten to swap.
DB_ENV=dev

# Local Development Database URL (Docker Compose defaults, or your OS Postgres user)
DEV_DATABASE_URL="postgresql://username:password@localhost:5432/liao_db?schema=public"

# Production Database URL (replace with your cloud database string)
PROD_DATABASE_URL="postgresql://username:password@prod-host:5432/liao_db?schema=public"

# Optional. Hosted platforms (Vercel) can set this instead of DEV_/PROD_.
# Leave unset locally so a leftover URL cannot override DB_ENV.
# DATABASE_URL=""

# JWT Secret (change this to a secure random string in production)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Seed Master Credentials (only used for seeding)
SEED_MASTER_PASS_1="yoursupersecretpassword1"
SEED_MASTER_PASS_2="yoursupersecretpassword2"

# Cloudinary (image hosting for production content URLs)
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
